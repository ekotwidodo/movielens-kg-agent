# Copy to .env and adjust. Never commit the real .env file.

# --- Knowledge graph build (CLI) ---
MOVIELENS_SOURCE_DIR=datasets/ml-latest-small
# Defaults to <MOVIELENS_SOURCE_DIR>/manifest.json when empty.
MOVIELENS_MANIFEST_PATH=
MOVIELENS_GRAPH_PATH=data/processed/movielens.ttl
MOVIELENS_REPORT_PATH=data/reports/import-report.json
# Placeholder namespace for the prototype. Not a permanent public identifier.
MOVIELENS_NAMESPACE=https://example.org/movielens/

# --- API ---
APP_ENV=development
LOG_LEVEL=INFO
# Set automatically inside Docker Compose. Needed when running the API on the host.
FUSEKI_QUERY_ENDPOINT=http://127.0.0.1:2004/movielens/sparql
# Used by both Fuseki (server time limit) and the API.
SPARQL_QUERY_TIMEOUT_SECONDS=120
SPARQL_MAX_RESULT_ROWS=100
SPARQL_MAX_QUERY_LENGTH=20000

AGENT_MAX_QUESTION_LENGTH=2000
# "template" (default): fixed wording around the result rows, no second LLM call.
# "llm": a second LLM call writes the answer from the result rows only.
AGENT_ANSWER_MODE=template

# --- Settings & Data Management Security ---
# 6-digit PIN required to access /setting-data
SETTINGS_ADMIN_PIN=123456

# --- Language model (any OpenAI-compatible Chat Completions API) ---
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=your-model
# Leave empty for local servers that need no key (e.g. Ollama: LLM_BASE_URL=http://host.docker.internal:11434/v1).
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0
# "json_schema" if the server supports structured outputs, otherwise "json_object".
LLM_RESPONSE_FORMAT=json_schema
# Retry with backoff when the provider answers 429 (rate limiting). Raising
# LLM_MAX_ATTEMPTS helps with OpenRouter ":free" models.
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=1

# --- Docker Compose ---
# ":80" for plain HTTP, or the domain name for automatic HTTPS.
SITE_ADDRESS=:80
# 127.0.0.1 when another host-level proxy forwards traffic; 0.0.0.0 to listen on all interfaces.
PROXY_BIND_ADDRESS=127.0.0.1
PROXY_HTTP_HOST_PORT=2001
PROXY_HTTPS_HOST_PORT=2002
API_DEBUG_HOST_PORT=2003
FUSEKI_DEBUG_HOST_PORT=2004
FUSEKI_JAVA_OPTIONS=-Xms1g -Xmx4g
